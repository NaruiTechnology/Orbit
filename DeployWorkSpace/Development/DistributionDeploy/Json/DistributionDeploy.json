{
  "Header": {
    "Application": "Orbit Automation Distribution Deploy",
    "TargetEnv": "Windows 10/11 with PowerShell 5.1+",
    "Version": "1.0.0",
    "Description": "Orbit deployment workflow aligned with the Iobeam DeployWorkSpace manifest, excluding Glasgow actions."
  },
  "Deployment": {
    "SourceRoot": ".",
    "DistDir": "DeployWorkSpace/Development/DistributionDeploy/dist_app",
    "DistZip": "DeployWorkSpace/Development/DistributionDeploy/dist_app.zip",
    "DeployRoot": "%USERPROFILE%\\OrbitAutomation",
    "VenvDir": ".venv",
    "ApiHost": "127.0.0.1",
    "ApiPort": 8120,
    "FrontendHost": "127.0.0.1",
    "FrontendPort": 5274,
    "DatabaseHost": "127.0.0.1",
    "DatabasePort": 55432,
    "DatabaseName": "OrbitAutomation",
    "DatabaseUser": "orbit_app"
  },
  "DistributionRules": {
    "PreservePythonSource": true,
    "CompilePython": false,
    "IncludeIgnoredFiles": false,
    "ExcludedWorkflowFamilies": ["Glasgow"]
  },
  "Actions": [
    {"createDeployFolder": {"skip": false, "transactionComplete": false, "actionData": {"command": "New-Item -ItemType Directory -Force -Path $env:USERPROFILE\\OrbitAutomation | Out-Null"}, "timeout": 30}},
    {"unzipDistribution": {"skip": false, "transactionComplete": false, "actionData": {"command": "Get-ChildItem DeployWorkSpace\\Development\\DistributionDeploy\\dist_app*.zip | Sort-Object LastWriteTime | Select-Object -Last 1 | Expand-Archive -DestinationPath $env:USERPROFILE\\OrbitAutomation -Force"}, "timeout": 120}},
    {"setupVirtualEnv": {"skip": false, "transactionComplete": false, "actionData": {"command": "$ErrorActionPreference='Stop'; python -m venv .venv; & .\\.venv\\Scripts\\python.exe -m pip install --upgrade pip"}, "timeout": 300}},
    {"installPipRequirements": {"skip": false, "transactionComplete": false, "actionData": {"command": "& .\\.venv\\Scripts\\python.exe -m pip install -r requirements.txt"}, "timeout": 600}},
    {"installNodeJS": {"skip": false, "transactionComplete": false, "actionData": {"command": "if (-not (Get-Command node -ErrorAction SilentlyContinue)) { throw 'Node.js is required; install the current LTS release from https://nodejs.org/' }"}, "timeout": 60}},
    {"installToolchain": {"skip": false, "transactionComplete": false, "actionData": {"command": "if (-not (Get-Command python -ErrorAction SilentlyContinue)) { throw 'Python 3.13+ is required' }; if (-not (Get-Command npm -ErrorAction SilentlyContinue)) { throw 'npm is required; install Node.js LTS' }; if (-not (Get-Command pg_config -ErrorAction SilentlyContinue)) { throw 'PostgreSQL client tools are required and pg_config.exe must be on PATH' }"}, "timeout": 60}},
    {"installOrbitServiceTask": {"skip": false, "transactionComplete": false, "actionData": {"command": "& .\\.venv\\Scripts\\python.exe scripts\\install_orbit_service_task.py"}, "timeout": 60}},
    {"installPostgreSQL": {"skip": false, "transactionComplete": false, "actionData": {"command": "& .\\scripts\\start_local_postgres.ps1"}, "timeout": 300}},
    {"verifyDatabase": {"skip": false, "transactionComplete": false, "actionData": {"command": "& .\\.venv\\Scripts\\python.exe scripts\\check_database.py --timeout 10"}, "timeout": 30}},
    {"setupIobeamAdminDb": {"skip": false, "transactionComplete": false, "actionData": {"command": "& .\\.venv\\Scripts\\python.exe scripts\\bootstrap_database.py"}, "timeout": 600}},
    {"exportEnv": {"skip": false, "transactionComplete": false, "actionData": {"exports": {"ORBIT_API_HOST": "127.0.0.1", "ORBIT_API_PORT": "8120", "ORBIT_FRONTEND_HOST": "127.0.0.1", "ORBIT_FRONTEND_PORT": "5274"}}}},
    {"setupIonbeamWeb": {"skip": false, "transactionComplete": false, "actionData": {"command": "npm --prefix frontend ci"}, "timeout": 600}},
    {"launchIonbeamWebBackend": {"skip": false, "transactionComplete": false, "actionData": {"command": "& .\\.venv\\Scripts\\python.exe scripts\\run_api.py --reload", "host": "127.0.0.1", "port": 8120}, "timeout": 60}},
    {"launchIonbeamWebFrontend": {"skip": false, "transactionComplete": false, "actionData": {"command": "npm --prefix frontend run dev -- --host 127.0.0.1", "host": "127.0.0.1", "port": 5274}, "timeout": 60}},
    {"verifyIonbeamWeb": {"skip": false, "transactionComplete": false, "actionData": {"healthUrl": "http://127.0.0.1:8120/api/v1/health", "frontendUrl": "http://127.0.0.1:5274"}, "timeout": 60}},
    {"launchUI": {"skip": false, "transactionComplete": false, "actionData": {"url": "http://127.0.0.1:5274"}, "timeout": 60}}
  ]
}
