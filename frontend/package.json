{
  "name": "orbit-automation-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React/Redux/TypeScript workflow workspace for Orbit Automation.",
  "scripts": {
    "dev": "vite",
    "dev:mobility": "VITE_MOBILITY_ONLY=1 vite",
    "build": "tsc -b && vite build",
    "build:mobility": "VITE_MOBILITY_ONLY=1 tsc -b && VITE_MOBILITY_ONLY=1 vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.12.0",
    "@tiptap/extension-table": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "ag-grid-community": "36.0.1",
    "ag-grid-enterprise": "36.0.1",
    "ag-grid-react": "36.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-redux": "9.3.0"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "engines": {
    "node": ">=24"
  }
}
